# ---- Core ----
NODE_ENV=development            # set to "production" when live (enables Secure cookies, HSTS)
PORT=3000
APP_URL=http://localhost:3000   # public URL, used in email links and Stripe redirects
APP_SECRET=                     # REQUIRED in production: 48+ random characters (encrypts 2FA secrets)
TRUST_PROXY=                    # set to 1 when running behind Nginx / Cloudflare / a load balancer
DATA_DIR=data                   # database + uploaded media live here — back it up

# ---- First platform admin (created on first start) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email (leave SMTP_HOST empty to print emails to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PostForge <no-reply@yourdomain.com>
REQUIRE_VERIFIED_EMAIL=true     # users must confirm their email before downloading

# ---- Stripe (leave empty for DEMO billing — no payments taken) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=           # recurring monthly price, US$12 per unit (seat)
STRIPE_PRICE_PRO=               # recurring monthly price, US$29 per unit (seat)
STRIPE_PRICE_BUSINESS=          # recurring monthly price, US$79 per unit (seat)
STRIPE_PRICE_STARTER_ANNUAL=    # recurring yearly price, US$120 per unit (2 months free)
STRIPE_PRICE_PRO_ANNUAL=        # recurring yearly price, US$290 per unit
STRIPE_PRICE_BUSINESS_ANNUAL=   # recurring yearly price, US$790 per unit

# ---- AI Studio (leave both keys empty for DEMO pictures — costs nothing) ----
GEMINI_API_KEY=                 # Google AI Studio key (recommended)
OPENAI_API_KEY=                 # optional alternative
AI_IMAGE_PROVIDER=              # gemini | openai (default: whichever key is set, Gemini first)
AI_DAILY_BUDGET_USD=20          # hard daily spending cap; admin can change it in Admin → AI studio
AI_JOBS=2                       # AI images made at the same time
AI_QUALITY_CHECK=true           # inspect each AI image for lettering / changed product (admin can switch it too)

# ---- Help & support ----
SUPPORT_EMAIL=                  # support messages are forwarded here (e.g. support@yourdomain.com)
SUPPORT_WHATSAPP=               # optional: WhatsApp number with country code, e.g. 9779800000000 (adds a chat button)

# ---- Closed beta ----
BETA_MODE=false                 # true = sign-up needs an invite code (create codes in Platform admin > Beta & feedback)

# ---- Admin security ----
REQUIRE_ADMIN_2FA=true          # platform admin area needs 2-step login (strongly recommended)
ADMIN_RESET_2FA=                # lost your authenticator phone? set true, restart, log in, set up again, then clear this

# ---- Error tracking & monitoring ----
SENTRY_DSN=                     # optional: Sentry project DSN (then run: npm install @sentry/node)
# Uptime: point UptimeRobot / Better Stack at  APP_URL/health  (returns 200 when healthy, 503 if not)

# ---- Landing page & analytics ----
DEMO_VIDEO_URL=                 # optional: https URL of your own demo video (MP4). Default: the built-in recording
PLAUSIBLE_DOMAIN=               # optional: your domain if you use Plausible. Built-in cookie-free analytics works without it

# ---- Backups (automatic daily; run a restore test before launch: npm run backup:verify) ----
BACKUP_ENABLED=true
BACKUP_DIR=                     # default: DATA_DIR/backups  — better: a different disk
BACKUP_KEEP=14                  # daily snapshots to keep
# Off-site copy to any S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3, Wasabi):
BACKUP_S3_ENDPOINT=             # e.g. https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=postforge

# ---- Social media posting (Facebook Pages + Instagram) ----
# Leave empty for DEMO mode (sample accounts, nothing is really posted).
# Create a Meta app at developers.facebook.com (see README "Social media posting").
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=           # optional: only if your app uses "Facebook Login for Business" configurations
META_GRAPH_VERSION=v25.0
# Instagram downloads each post from APP_URL, so APP_URL must be your public https address (not localhost).
